# General
TZ=America/Lima

# PostgreSQL
POSTGRES_DB=bank_transfer
POSTGRES_USER=postgres
# Set a local, strong password before starting the infrastructure.
POSTGRES_PASSWORD=
POSTGRES_PORT=15432

# Application database connection
DATABASE_URL=jdbc:postgresql://localhost:15432/bank_transfer
DATABASE_USER=postgres
# Must match POSTGRES_PASSWORD.
DATABASE_PASSWORD=
DATABASE_MAX_POOL_SIZE=16
DATABASE_MIN_POOL_SIZE=2

# Kafka
KAFKA_PORT=19092
KAFKA_ADVERTISED_HOST=localhost
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_GROUP_ID=transfer-consumer-group
KAFKA_TRANSFER_TOPIC=bank.transfer.created
KAFKA_TRANSFER_PARTITIONS=1

# Schema Registry
SCHEMA_REGISTRY_PORT=8083
SCHEMA_REGISTRY_URL=http://localhost:8083

# AKHQ
AKHQ_PORT=9021

# Application HTTP ports
TRANSFER_API_HTTP_PORT=8081
TRANSFER_CONSUMER_HTTP_PORT=8082

# JWT
JWT_ISSUER=bank-transfer
JWT_EXPIRATION=15M

# Secretos locales obligatorios para ejecutar los contenedores de la aplicación.
# Reemplaza ambos valores antes de ejecutar start-all.sh; no uses estos valores en producción.
JWT_SECRET=replace-with-a-local-random-secret
DEMO_PASSWORD=replace-with-a-local-demo-password

# Exchange rate API
EXCHANGE_RATE_API_BASE_URL=https://api.frankfurter.dev
EXCHANGE_RATE_API_CONNECT_TIMEOUT=2S
EXCHANGE_RATE_API_READ_TIMEOUT=3S
